PORT=5000
NODE_ENV=development

# Local MongoDB instance for development.
# If you use MongoDB Atlas instead, paste your connection string here.
MONGODB_URI=your_mongodb_connection_string_here

FRONTEND_URL=http://localhost:5173

# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_this_with_a_real_secret

# The Python schema-diff microservice (diff-service/), run separately
# with: uvicorn app.main:app --reload --port 8000
DIFF_SERVICE_URL=http://localhost:8000

# Email alerts via Brevo's HTTPS API (not SMTP)
BREVO_API_KEY=xkeysib-...
ALERT_FROM_EMAIL=your_verified_gmail@gmail.com