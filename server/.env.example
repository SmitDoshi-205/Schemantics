PORT=5000
NODE_ENV=development

# Local MongoDB instance for development.
# If you use MongoDB Atlas instead, paste your connection string here.
MONGODB_URI=mongodb://127.0.0.1:27017/schemantics

FRONTEND_URL=http://localhost:5173

# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_this_with_a_real_secret

# The Python schema-diff microservice (diff-service/), run separately
# with: uvicorn app.main:app --reload --port 8000
DIFF_SERVICE_URL=http://localhost:8000

# Email alerts - uses the Resend API
# Get a free API key at https://resend.com.
RESEND_API_KEY=re_replace_with_your_real_key
# Must be a verified domain on your Resend account, OR use Resend's
# shared testing address below (no domain verification needed):
ALERT_FROM_EMAIL=Schemantics <onboarding@resend.dev>